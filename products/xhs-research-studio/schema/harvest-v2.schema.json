{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/xhs-harvest-v2.schema.json",
  "title": "Xiaohongshu Harvest v2",
  "type": "object",
  "required": ["schemaVersion", "source", "notes", "comments", "authors", "queries", "meta"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "source": {
      "type": "object",
      "required": ["platform", "capturedAt", "entry", "captureMethod"],
      "properties": {
        "platform": {"const": "xiaohongshu"},
        "capturedAt": {"type": "string", "format": "date-time"},
        "entry": {"enum": ["search", "profile", "note", "shortlink", "topic", "feed", "mixed", "unknown"]},
        "keyword": {"type": "string"},
        "sourceUrl": {"type": "string"},
        "captureMethod": {"enum": ["initial_state", "rendered_dom", "ocr", "mixed", "unknown"]},
        "session": {"type": "string"}
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["noteId", "author", "stats", "captureMethod", "confidence"],
        "properties": {
          "noteId": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "desc": {"type": "string"},
          "type": {"type": "string"},
          "publishTime": {},
          "lastUpdateTime": {},
          "ipLocation": {"type": "string"},
          "tags": {"type": "array"},
          "atUsers": {"type": "array"},
          "authorStatement": {"type": "string"},
          "author": {
            "type": "object",
            "properties": {
              "userId": {"type": "string"},
              "nickname": {"type": "string"},
              "profileUrl": {"type": "string"}
            },
            "additionalProperties": true
          },
          "stats": {
            "type": "object",
            "required": ["likes", "collects", "comments", "shares"],
            "properties": {
              "likes": {"type": "integer", "minimum": 0},
              "collects": {"type": "integer", "minimum": 0},
              "comments": {"type": "integer", "minimum": 0},
              "shares": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": true
          },
          "media": {"type": "object"},
          "comments": {"type": "array"},
          "sourceUrl": {"type": "string"},
          "captureMethod": {"enum": ["initial_state", "rendered_dom", "ocr", "mixed", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "id": {"type": "string"},
          "noteId": {"type": "string"},
          "parentCommentId": {"type": "string"},
          "content": {"type": "string", "minLength": 1},
          "likes": {"type": "integer", "minimum": 0},
          "isAuthor": {"type": "boolean"},
          "user": {"type": ["string", "object"]},
          "publishedAt": {},
          "sourceUrl": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "authors": {"type": "array"},
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyword", "capturedAt", "results"],
        "properties": {
          "keyword": {"type": "string", "minLength": 1},
          "capturedAt": {"type": "string", "format": "date-time"},
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rankingPosition"],
              "properties": {
                "noteId": {"type": "string"},
                "rankingPosition": {"type": "integer", "minimum": 1},
                "sourceUrl": {"type": "string"},
                "title": {"type": "string"},
                "author": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "required": ["gaps", "loginRequired", "riskState"],
      "properties": {
        "inputSchemaVersion": {"type": "string"},
        "collected": {"type": "integer", "minimum": 0},
        "deduped": {"type": "integer", "minimum": 0},
        "gaps": {"type": "array"},
        "loginRequired": {"type": "boolean"},
        "riskState": {"enum": ["NORMAL", "THROTTLED", "LOGIN_REQUIRED", "CAPTCHA", "ACCESS_DENIED", "BLOCKED"]},
        "sampleBudget": {"type": ["integer", "null"], "minimum": 0},
        "stoppedBecause": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
